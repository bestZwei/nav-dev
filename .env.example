# ===== 数据库配置 =====
# 默认使用 SQLite（零配置）：未配置 PostgreSQL 连接参数时自动生效，
# 数据文件路径由 SQLITE_PATH 控制（默认 /app/data/nav.db，本地开发为 ./data/nav.db），
# 文件或目录缺失时自动创建，首次启动自动建表并写入种子数据。
#
# 切换 PostgreSQL：设置 POSTGRES_URL（或保留原 DATABASE_URL 且值为 postgres:// 前缀）
# DB_PROVIDER 可显式指定 sqlite | postgres；未设置时按连接参数自动推断
DB_PROVIDER=
POSTGRES_URL=
# 兼容旧配置：postgres:// 前缀的 DATABASE_URL 等同 POSTGRES_URL
DATABASE_URL=
# SQLite 数据库文件路径（留空使用默认值）
SQLITE_PATH=

# PostgreSQL（docker-compose --profile postgres 模式下的容器参数）
POSTGRES_DB=
POSTGRES_PASSWORD=
POSTGRES_PORT=
POSTGRES_USER=

# 会话签名密钥（HMAC）：生产环境务必设置为随机长字符串，未设置时回退 NEXTAUTH_SECRET
SESSION_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
# 工作区预览参数开关：设为 true 时可用 ?__workspace=<slug> 模拟子域名访问（开发模式默认开启，生产忽略）
ENABLE_WORKSPACE_PREVIEW=

# 初始管理员账号（仅首次 seed 生效）：公网部署务必设置 ADMIN_PASSWORD
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 构建版本信息（Docker 构建时注入，本地开发可留空）
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_GIT_SHA=

# 会话密钥文件路径（entrypoint 兜底密钥持久化位置；
# Docker 镜像默认 /app/.session-data/.session-secret，位于 compose 挂载卷内可持久化）
SESSION_SECRET_FILE=
