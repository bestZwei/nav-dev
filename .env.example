DATABASE_URL=
# 会话签名密钥（HMAC）：生产环境务必设置为随机长字符串，未设置时回退 NEXTAUTH_SECRET
SESSION_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
# 工作区预览参数开关：设为 true 时可用 ?__workspace=<slug> 模拟子域名访问（开发模式默认开启，生产忽略）
ENABLE_WORKSPACE_PREVIEW=
POSTGRES_DB=
POSTGRES_PASSWORD=
POSTGRES_PORT=
POSTGRES_USER=

# 初始管理员账号（仅首次 seed 生效）：公网部署务必设置 ADMIN_PASSWORD
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 构建版本信息（Docker 构建时注入，本地开发可留空）
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_GIT_SHA=

# 会话密钥文件路径（entrypoint 兜底密钥持久化位置，Docker 内默认 /app/.session-secret）
SESSION_SECRET_FILE==